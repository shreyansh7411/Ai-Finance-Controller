# ============================================================
# AI Finance Controller — Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env to source control.
# ============================================================

# PostgreSQL connection
DB_URL=jdbc:postgresql://localhost:5432/ai-fin-controller
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# Backend server port (default: 8080)
SERVER_PORT=8080

# (Phase 5+) AI provider key — leave blank until needed
# AI_PROVIDER_API_KEY=

# (Phase 2+) Razorpay test-mode credentials — leave blank until needed
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
